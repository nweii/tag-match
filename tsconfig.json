{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "allowJs": true, "noEmit": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.mjs", "scripts/**/*.ts", "scripts/**/*.mjs", "tests/fixtures/*.mjs"]
}
